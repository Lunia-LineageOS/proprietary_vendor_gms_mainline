android_app_import {
    name: "CaptivePortalLoginGoogle",
    owner: "google",
    apk: "CaptivePortalLoginGoogle/CaptivePortalLoginGoogle.apk",
    overrides: ["CaptivePortalLogin"],
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
}

android_app_import {
    name: "DocumentsUIGoogle",
    owner: "google",
    apk: "DocumentsUIGoogle/DocumentsUIGoogle.apk",
    overrides: [
        "DocumentsUI",
        "DocumentsUIOverlay",
    ],
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
}

android_app_import {
    name: "ModuleMetadataGoogle",
    owner: "google",
    apk: "ModuleMetadataGoogle/ModuleMetadataGoogle.apk",
    overrides: ["ModuleMetadata"],
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}

android_app_import {
    name: "NetworkStackGoogle",
    owner: "google",
    apk: "NetworkStackGoogle/NetworkStackGoogle.apk",
    overrides: ["NetworkStack"],
    required: ["com.google.android.networkstack.xml"],
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
}

prebuilt_etc {
    name: "com.google.android.networkstack.xml",
    src: "etc/permissions/com.google.android.networkstack.xml",
    sub_dir: "permissions",
}

// Selected by the RELEASE_APEX_CONTRIBUTIONS_* flags in build/release/gms_mainline.
// The app-only ones have no same-named source module to replace, but must
// exist because the flags reference them.
apex_contributions {
    name: "captiveportallogin.google.contributions.prebuilt",
}

apex_contributions {
    name: "documentsui.google.contributions.prebuilt",
}

apex_contributions {
    name: "modulemetadata.google.contributions.prebuilt",
}

apex_contributions {
    name: "networkstack.google.contributions.prebuilt",
}
